# Python Backend Environment Variables (Trade Aid)
# Copy these to Railway service: trade-aid-backend

# Database (Railway PostgreSQL - auto-provided)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Redis (Railway Redis - auto-provided)
REDIS_URL=redis://default:pass@host:port

# Security - CHANGE THESE!
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
MASTER_ACCESS_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
ENCRYPTION_KEY=CHANGE_THIS_TO_32_PLUS_CHAR_STRING

# CORS - Update with your frontend URL
CORS_ORIGINS=https://your-frontend.railway.app,https://tradeaid.app

# App Configuration
APP_NAME=Trade Aid
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENABLED_CHAINS=solana,ethereum,bsc,base,arbitrum,avalanche,polygon

# API Keys (Optional - for enhanced features)
DEXSCREENER_API_KEY=
BIRDEYE_API_KEY=
HELIUS_API_KEY=f24ee3ce-fb03-4685-bf64-185ae3161ebc
