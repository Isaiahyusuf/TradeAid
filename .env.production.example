# Production environment example for TradeAid
# Copy this to .env.production and fill real secrets before deploying.

# Core
DATABASE_URL=postgres://user:password@db:5432/tradeaid
PORT=5000
NODE_ENV=production
SESSION_SECRET=replace_with_secure_random_string
REDIS_URL=redis://redis:6379

# AI / External integrations
AI_INTEGRATIONS_OPENAI_API_KEY=sk-REPLACE_WITH_KEY
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_API_KEY=

# Worker / Python service (trade_aid)
TRADE_AID_DATABASE_URL=postgres://user:password@db:5432/trade_aid
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Payments & webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security & misc
ENCRYPTION_KEY=replace_with_32_plus_characters
MASTER_ACCESS_KEY=
SENTRY_DSN=

# Optional provider keys
HELIUS_API_KEY=
ALCHEMY_API_KEY=
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Note: Do not commit actual secrets. Use your host provider's secret store.
# Example production environment variables for TradeAid
# Copy this to .env.production and fill values before deploying.

# Core
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_strong_random_value

# Cache / Workers
REDIS_URL=redis://:password@redis-host:6379
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Blockchain / Scanner
HELIUS_API_KEY=your_helius_api_key_here
# If you later re-enable EVM features, optionally set these:
# ALCHEMY_API_KEY=your_alchemy_api_key
# BSCSCAN_API_KEY=your_bcscan_api_key
# ETHERSCAN_API_KEY=your_etherscan_api_key

# AI / Integrations
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# Payments (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Security
ENCRYPTION_KEY=replace_with_32_plus_char_secret
MASTER_ACCESS_KEY=
SENTRY_DSN=

# Optional tuning
# LOG_LEVEL=info

# Note: Do NOT commit secrets to source control. Use Railway or your host's secrets manager.
