# Local environment example (for development using docker-compose)
# Copy to .env.local and adjust values before running `scripts\setup-and-run.ps1`.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradeaid
PORT=5000
NODE_ENV=development
SESSION_SECRET=dev_secret_replace_me
REDIS_URL=redis://localhost:6379

# AI / External integrations (use dev/test keys)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-REPLACE_WITH_KEY
OPENAI_API_KEY=

# Python service
TRADE_AID_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trade_aid
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
