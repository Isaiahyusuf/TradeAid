# Web Frontend Environment Variables (Node.js/Express)
# Copy these to Railway service: web-frontend

# Node Environment
NODE_ENV=production

# Database (Railway PostgreSQL - auto-provided, same as backend)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Session Secret - CHANGE THIS!
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# API URL (Python backend URL from Railway)
VITE_API_URL=https://trade-aid-backend-production.up.railway.app

# Public URL (your web frontend URL)
PUBLIC_URL=https://tradeaid.up.railway.app

# Port (Railway auto-assigns, but default for local)
PORT=3000
