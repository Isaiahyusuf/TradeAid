{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE"
  },
  "nixpacks": {
    "phases": {
      "setup": {
        "nixPkgs": ["nodejs-18_x"]
      },
      "install": {
        "workDir": "client",
        "cmds": ["npm install"]
      },
      "build": {
        "workDir": "client",
        "cmds": ["npm run build"]
      }
    },
    "start": {
      "workDir": "client",
      "cmd": "npm run start"
    }
  }
}
