# TradeAid Backend API URL
# Development (local backend)
API_URL=http://localhost:8000
APP_ENV=development

# Production (your deployed Railway backend)
# API_URL=https://your-tradeaid-backend.up.railway.app

# For Expo builds, use EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_URL=http://localhost:8000

# Store builds must override these values in EAS secrets/env:
# APP_ENV=production
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
