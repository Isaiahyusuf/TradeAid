# ============================================================
# TRADE AID - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# ---- APPLICATION ----
APP_NAME=Trade Aid
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=trade_aid.log

# ---- DATABASE ----
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@postgres:5432/trade_aid
DATABASE_URL_SYNC=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/trade_aid
POSTGRES_DB=trade_aid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# ---- REDIS ----
REDIS_URL=redis://redis:6379/0

# ---- CELERY ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT AUTH ----
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_CHANGE_THIS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- MASTER ACCESS KEY ----
MASTER_ACCESS_KEY=YOUR_MASTER_KEY_CHANGE_THIS

# ---- ENCRYPTION ----
ENCRYPTION_KEY=YOUR_32_CHAR_ENCRYPTION_KEY_HERE!

# ---- AI SERVICE ----
AI_SERVICE_URL=http://ai_service:8001

# ---- TELEGRAM ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- DEXSCREENER ----
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex
SCAN_INTERVAL_SECONDS=10

# ---- DOCTORTRADE MULTI-SOURCE SCANNER ----
COINGECKO_API_KEY=
SOLSCAN_API_KEY=
BITQUERY_API_KEY=
HELIUS_API_KEY=
MORALIS_API_KEY=
JUPITER_API_KEY=
WALLETBOT_KEY=
COVALENT_API_KEY=
THE_GRAPH_ENDPOINT=

DOCTOR_MIN_LIQUIDITY_USD=20000
DOCTOR_MIN_VOLUME_24H_USD=5000
DOCTOR_MIN_AGE_MINUTES=5
DOCTOR_MAX_AGE_MINUTES=1440
DOCTOR_MIN_LIQUIDITY_USD=500
DOCTOR_MIN_VOLUME_24H_USD=100
DOCTOR_MIN_AGE_MINUTES=5
DOCTOR_MAX_AGE_MINUTES=1440
# ---- RPC ENDPOINTS ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
POLYGON_RPC_URL=https://polygon-rpc.com/

# ---- WEBSOCKET RPC ENDPOINTS ----
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
ETHEREUM_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_WS_URL=wss://bsc-ws-node.nariox.org:443
BASE_WS_URL=
ARBITRUM_WS_URL=
AVALANCHE_WS_URL=
POLYGON_WS_URL=

# ---- CORS ----
CORS_ORIGINS=*

# ---- RATE LIMITING ----
RATE_LIMIT_PER_MINUTE=60

# ---- SCORING ELIGIBILITY ----
MIN_LIQUIDITY_AGE_MINUTES=30
MIN_MARKET_CAP_USD=25000
